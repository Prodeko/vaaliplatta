POSTGRES_HOST=localhost
POSTGRES_PASSWORD=secret
POSTGRES_DB=vaaliplatta
POSTGRES_PORT=5432
POSTGRES_USER=vaaliplatta

# Need this only for kysely-codegen
DATABASE_URL='postgres://vaaliplatta:secret@localhost:5432/vaaliplatta?disablessl=true'

ENV='DEV'
# Overrides the ENV-based default ('true' in DEV). Set to 'false' to hit Keycloak from a local dev setup.
USE_MOCK_AUTHENTICATION=
FRONTEND_DIST_FOLDER='../../frontend/dist' # In production, this should be '../../../frontend/dist'
PORT=8000
LOG_LEVEL='VERBOSE'
JWT_SECRET= # create a random secret with e.g. `openssl rand -base64 32`
JWT_EXPIRATION='30d'

# Blob sas connection string for the server. This should have Read / Write permissions
# Go to Azure > Resource Accounts > vaaliplatta > Containers > (dev / prod) > Settings > Shared access tokens
AZ_BLOB_CONNECTION_STRING=

# Keycloak — user-facing login client (public or confidential, PKCE enabled)
KEYCLOAK_URL='https://keycloak.example.com'
KEYCLOAK_REALM='prodeko'
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CALLBACK_URI='http://localhost:8000/oauth2/callback'

# Keycloak — service-account client used by /api/users/search.
# Needs the realm-management `view-users` role granted as a service-account role.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Realm role whose members are superusers in vaaliplatta.
KEYCLOAK_SUPERUSER_ROLE='vaaliplatta-admin'

FRONTEND_URL='http://localhost:5173' # 5173 if using dev, 8000 if using vite build
AUTH_COOKIE_MAX_AGE_MILLISECONDS=2678400000 #1 month
